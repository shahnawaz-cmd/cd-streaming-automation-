# Application Target Environment URL
BASE_URL=https://dev.example.com

# MongoDB Configuration
# Format: mongodb://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<AUTH_DB>?ssl=true
MONGO_URI=mongodb://your_username:your_password@your_host:27017/?authSource=admin&ssl=true
MONGO_DB_NAME=your_database_name
MONGO_COLL_NAME=your_collection_name
